# backend/.env 로 복사해서 사용합니다. 실제 값은 Git에 올리지 않습니다.
# 이 파일의 값은 모두 예시입니다.

# 실행 환경: local | test | production
APP_ENV=local

# PostgreSQL 비동기 연결 주소 (SQLAlchemy + asyncpg 드라이버)
# 형식: postgresql+asyncpg://사용자:비밀번호@호스트:포트/DB이름
# Supabase 를 쓰면 대시보드의 연결 문자열 중 Session pooler 값에서 드라이버만 postgresql+asyncpg 로 바꿉니다.
# 비워 두면 서버는 켜지지만 DB 를 쓰는 기능은 503 으로 응답합니다.
DATABASE_URL=

# JWT 서명 비밀 키: 32자 이상 임의 문자열. 팀원마다 로컬에서 직접 생성합니다.
# 생성 예) python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS 허용 출처 (쉼표로 구분, 와일드카드 * 사용 금지)
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
