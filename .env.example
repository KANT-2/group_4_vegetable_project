# Supabase 연결 전에는 두 값을 비워 두어도 공통 화면을 실행할 수 있습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI 백엔드 기본 주소 (브라우저에 공개되는 값이므로 비밀번호·키를 넣지 않습니다)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# 백엔드 비밀값(DATABASE_URL, JWT_SECRET_KEY 등)은 backend/.env 에만 둡니다. backend/.env.example 참고.
