# 패키지 (npm install로 다시 설치 가능)
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js 빌드 결과물
.next/
out/
build/

# 테스트 결과
coverage/

# 환경 변수 (Supabase 키가 들어 있으므로 절대 올리면 안 됨)
.env
.env*.local
.env.development
.env.production

# Supabase 로컬 개발 임시 파일
supabase/.temp/
supabase/.branches/

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 운영체제 자동 생성 파일
.DS_Store
Thumbs.db
desktop.ini

# 에디터 설정 (개인 설정)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# 기타
*.pem

# 개인 실행 데이터베이스와 Python 캐시
var/food-catalog/
__pycache__/
*.pyc
